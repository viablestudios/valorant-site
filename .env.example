# Public URL used for canonical links, sitemap and Stripe redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Payment provider: "mock" (default) or "stripe"
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Secret used to sign expiring download links
DOWNLOAD_TOKEN_SECRET=change-me-to-a-long-random-string
